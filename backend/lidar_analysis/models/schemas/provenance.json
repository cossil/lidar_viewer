{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidar-analysis.local/schema/provenance.json",
  "title": "Provenance",
  "type": "object",
  "required": [
    "origin",
    "user_validated"
  ],
  "properties": {
    "origin": {
      "type": "string",
      "enum": [
        "SOURCE",
        "USER_DEFINED",
        "DERIVED",
        "ASSUMED",
        "MODELED",
        "SIMULATED",
        "EMPIRICAL"
      ]
    },
    "document": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "section": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_method": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "manual",
        "ai",
        "parser",
        "calculation",
        "experiment",
        "import",
        null
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "user_validated": {
      "type": "boolean"
    },
    "validation_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
