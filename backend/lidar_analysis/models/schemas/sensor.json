{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidar-analysis.local/schema/sensor.json",
  "title": "LiDAR Sensor",
  "type": "object",
  "required": [
    "sensor_id",
    "manufacturer",
    "model",
    "version",
    "sensor_type",
    "range",
    "scan",
    "provenance",
    "validation"
  ],
  "properties": {
    "sensor_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "hardware_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "firmware_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string"
    },
    "sensor_type": {
      "type": "string",
      "enum": [
        "mechanical_spinning",
        "structured_raster",
        "non_repetitive",
        "other"
      ]
    },
    "wavelength": {
      "$ref": "parameter.json"
    },
    "range": {
      "$ref": "#/$defs/range"
    },
    "accuracy": {
      "$ref": "#/$defs/accuracy"
    },
    "precision": {
      "$ref": "#/$defs/precision"
    },
    "angular": {
      "$ref": "#/$defs/angular"
    },
    "beam": {
      "$ref": "#/$defs/beam"
    },
    "scan": {
      "$ref": "#/$defs/scan"
    },
    "optical": {
      "$ref": "#/$defs/optical"
    },
    "detection": {
      "$ref": "#/$defs/detection"
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "provenance.json"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "properties": {
        "minimum": {
          "$ref": "parameter.json"
        },
        "maximum": {
          "$ref": "parameter.json"
        },
        "max_representable_range": {
          "$ref": "parameter.json"
        },
        "reflectivity_curves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rangeCurve"
          }
        }
      },
      "additionalProperties": false
    },
    "rangeCurve": {
      "type": "object",
      "required": [
        "reflectivity",
        "maximum_range"
      ],
      "properties": {
        "reflectivity": {
          "$ref": "parameter.json"
        },
        "maximum_range": {
          "$ref": "parameter.json"
        },
        "conditions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "accuracy": {
      "type": "object",
      "properties": {
        "range": {
          "$ref": "parameter.json"
        },
        "angular": {
          "$ref": "parameter.json"
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "precision": {
      "type": "object",
      "properties": {
        "range": {
          "$ref": "parameter.json"
        },
        "range_min": {
          "$ref": "parameter.json"
        },
        "range_max_10pct": {
          "$ref": "parameter.json"
        },
        "angular": {
          "$ref": "parameter.json"
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "angular": {
      "type": "object",
      "properties": {
        "horizontal_fov": {
          "$ref": "parameter.json"
        },
        "vertical_fov": {
          "$ref": "parameter.json"
        },
        "horizontal_resolution": {
          "$ref": "parameter.json"
        },
        "vertical_resolution": {
          "$ref": "parameter.json"
        },
        "horizontal_uncertainty": {
          "$ref": "parameter.json"
        },
        "vertical_uncertainty": {
          "$ref": "parameter.json"
        },
        "channel_count": {
          "$ref": "parameter.json"
        },
        "channel_angles": {
          "type": "array",
          "items": {
            "$ref": "parameter.json"
          }
        }
      },
      "additionalProperties": false
    },
    "beam": {
      "type": "object",
      "properties": {
        "horizontal_divergence": {
          "$ref": "parameter.json"
        },
        "vertical_divergence": {
          "$ref": "parameter.json"
        },
        "beam_shape": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "circular",
            "elliptical",
            "gaussian",
            "unknown",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "scan": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "mechanical_spinning",
            "structured_raster",
            "non_repetitive",
            "other"
          ]
        },
        "point_rate": {
          "$ref": "parameter.json"
        },
        "frame_rate": {
          "$ref": "parameter.json"
        },
        "rotation_frequency": {
          "$ref": "parameter.json"
        },
        "horizontal_resolution": {
          "$ref": "parameter.json"
        },
        "vertical_resolution": {
          "$ref": "parameter.json"
        },
        "scan_phase": {
          "$ref": "parameter.json"
        },
        "coverage_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "returns_per_pulse": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "optical": {
      "type": "object",
      "properties": {
        "wavelength": {
          "$ref": "parameter.json"
        },
        "receiver_aperture": {
          "$ref": "parameter.json"
        },
        "pulse_energy": {
          "$ref": "parameter.json"
        }
      },
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "properties": {
        "default_model": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "datasheet",
            "analytical",
            "empirical",
            "assumption",
            null
          ]
        },
        "threshold": {
          "$ref": "parameter.json"
        },
        "empirical_curves": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unvalidated",
            "partially_validated",
            "validated"
          ]
        },
        "validated_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "validated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
